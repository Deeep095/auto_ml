      "name": "Loop Over Items"
    },
    {
      "parameters": {
        "jsCode": "const input = JSON.parse($input.first().json.chatInput);\n\nconst models = input.models\n    ? input.models\n    : (input.model ? [input.model] : []);\n\nconst visualizations = Array.isArray(input.visualizations)\n    ? input.visualizations\n    : (input.visualizations ? [input.visualizations] : []);\n\nreturn [\n  {\n    json: {\n      dataset_path: input.dataset_path,\n\n      execution_plan: {\n        problem_type: input.problem_type,\n        target_column: input.target_column,\n\n        preprocessing: {\n          missing_values: \"mean\",\n          categorical_missing: \"most_frequent\",\n          encoding: \"onehot\",\n          scaling: \"standard\"\n        },\n\n        recommended_models: models.map((model, index) => ({\n          priority: index + 1,\n          name: model\n        })),\n\n        visualizations: visualizations.map(v => ({\n          type: v\n        })),\n\n        test_size: input.test_size ?? 0.2,\n        random_state: input.random_state ?? 42,\n        confidence: input.confidence ?? 1.0\n      }\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -128,
        560
      ],
      "id": "7241e72a-0a38-474c-928c-bfea86ddbf4e",
      "name": "Get data"
    },
    {
      "parameters": {
        "jsCode": "const result = $input.first().json;\n\nlet message = `🤖 *Virtuoso AutoML Results*\n\n`;\n\nmessage += `📊 Dataset Shape: ${result.dataset_shape[0]} × ${result.dataset_shape[1]}\n\n`;\n\nmessage += `🎯 Problem Type: ${result.problem_type}\n`;\nmessage += `🎯 Target Column: ${result.target_column}\n\n`;\n\nmessage += `🏆 *Best Model*\n`;\nmessage += `• ${result.best_model.model}\n\n`;\n\nmessage += `📈 Metrics\n\n`;\n\nfor (const model of result.all_models) {\n\n    message += `🔹 *${model.model}*\\n`;\n\n    for (const [key, value] of Object.entries(model)) {\n\n        if (key === \"model\") continue;\n\n        message += `   ${key}: ${value}\\n`;\n    }\n\n    message += `\\n`;\n}\n\nreturn [\n{\n    json:{\n        telegram_message:message,\n        artifacts:result.artifacts\n    }\n}\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        320,
        560
      ],
      "id": "1c6753fe-0ce4-41da-ba89-a1bd8cfe1bb8",
      "name": "Get Output"
    },
    {
      "parameters": {
        "jsCode": "const artifacts = $input.first().json.artifacts\n\nconst items = [];\n\nfor (const [name, path] of Object.entries(artifacts)) {\n\n    if (!path.endsWith(\".png\")) continue;\n\n    items.push({\n        json: {\n            title: name,\n            path: path\n        }\n    });\n\n}\n\nreturn items;"
      },
      "type": "n8n-nodes-base.code",
